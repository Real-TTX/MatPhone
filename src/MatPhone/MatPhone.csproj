<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>MatPhone</RootNamespace>
    <AssemblyName>MatPhone</AssemblyName>
    <UserSecretsId>matphone</UserSecretsId>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <!-- Pinned to the same version as the design-time package, so the tests resolve one consistent EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Draws the QR code of the authenticator app set-up as SVG (pure managed, no external service) -->
    <PackageReference Include="QRCoder" Version="1.*" />
    <!-- Sends voicemail messages and test mails (SMTP) -->
    <PackageReference Include="MailKit" Version="4.*" />
    <!-- MailKit brings an older one with known vulnerabilities: pinned to the patched release -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- SMB client: backups on a NAS -->
    <PackageReference Include="SMBLibrary" Version="1.5.7.1" />
    <!-- The telephony engine: SIP (registrar, trunks, calls), RTP and WebRTC for the browser client -->
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MatPhone.Core\MatPhone.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MatPhone.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The texts of the interface, English and German (MatPhone.Localization.TextCatalog) -->
    <EmbeddedResource Include="Resources\Texts\*.json" />
  </ItemGroup>

</Project>
