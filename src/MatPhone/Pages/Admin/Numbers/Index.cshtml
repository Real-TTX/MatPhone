@page
@model MatPhone.Pages.Admin.Numbers.IndexModel

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />
    <partial name="_Table" model="Model.Table" />
    <partial name="_Pager" model="Model.Pager" />
    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="/Admin/Numbers/Edit">@Ui.Icon("plus")<span>@L["Numbers.New"]</span></a>
        <a class="mat-btn mat-btn--secondary" href="/Admin/Numbers/Edit?kind=External">@Ui.Icon("plus")<span>@L["Numbers.NewExternal"]</span></a>
    </div>
</div>
