@page
@using MatPhone.Configuration
@model MatPhone.Pages.Admin.MailModel
@{
    var security = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new(L["Admin.Mail.Security.Auto"], nameof(MailSecurity.Auto)),
        new(L["Admin.Mail.Security.StartTls"], nameof(MailSecurity.StartTls)),
        new(L["Admin.Mail.Security.Ssl"], nameof(MailSecurity.SslOnConnect)),
        new(L["Admin.Mail.Security.None"], nameof(MailSecurity.None)),
    };
}

<form class="mat-form" method="post" asp-page-handler="" novalidate>
    <mp-summary />
    @if (Model.TestResult is not null)
    {
        <div class="mat-alert mat-alert--@(Model.TestOk ? "success" : "danger")" role="status">@Ui.Icon(Model.TestOk ? "check-circle" : "alert")<div class="mat-alert__body">@Model.TestResult</div></div>
    }

    <mp-card title="@L["Admin.Mail.Server"]" icon="server">
        <div class="mat-form__grid">
            <mp-input for="Input.Host" label="@L["Admin.Mail.Host"]" hint="@L["Admin.Mail.Host.Hint"]" autocomplete="off" />
            <mp-input for="Input.Port" label="@L["Admin.Mail.Port"]" type="number" min="1" max="65535" step="1" show-if="Input.Host" />
            <mp-select for="Input.Security" label="@L["Admin.Mail.Security"]" items="security" show-if="Input.Host" />
            <mp-input for="Input.UserName" label="@L["Admin.UserName"]" autocomplete="off" show-if="Input.Host" />
            <mp-input for="Input.Password" label="@L["Admin.Password"]" type="password" autocomplete="new-password" show-if="Input.Host" hint="@(Model.HasPassword ? L["Admin.Password.Keep"] : L["Admin.Password.Encrypted"])" />
            <mp-input for="Input.FromAddress" label="@L["Admin.Mail.FromAddress"]" type="email" inputmode="email" show-if="Input.Host" />
            <mp-input for="Input.FromName" label="@L["Admin.Mail.FromName"]" show-if="Input.Host" hint="@L["Admin.Mail.FromName.Hint"]" />
        </div>
    </mp-card>

    <mp-card title="@L["Admin.Mail.VoicemailMail"]" icon="voicemail">
        <p class="mat-muted">@L["Admin.Mail.Placeholders"]</p>
        <div class="mat-form__grid">
            <mp-input for="Input.VoicemailSubject" label="@L["Admin.Mail.Subject"]" required="true" full="true" />
            <mp-textarea for="Input.VoicemailBody" label="@L["Admin.Mail.Body"]" rows="8" required="true" full="true" />
        </div>
    </mp-card>

    <mp-card title="@L["Admin.Mail.Test"]" icon="send">
        <div class="mat-form__grid">
            <mp-input name="TestTo" for="TestTo" label="@L["Admin.Mail.TestTo"]" type="email" inputmode="email" hint="@L["Admin.Mail.TestTo.Hint"]" autocomplete="off" />
        </div>
        <div class="mat-actions">
            <button type="submit" class="mat-btn mat-btn--secondary" asp-page-handler="Test">@Ui.Icon("send")<span>@L["Admin.Mail.Test.Send"]</span></button>
        </div>
    </mp-card>

    <mp-buttons back-href="/" />
</form>
