@page
@model MatPhone.Pages.Admin.Logs.RetentionModel

<form class="mat-form" method="post" asp-page-handler="" novalidate>
    <mp-summary />
    <mp-card title="@L["Logs.Retention.Days"]" icon="archive" sub="@L["Logs.Retention.Days.Sub"]">
        <div class="mat-form__grid">
            <mp-input for="Input.CallDays" label="@L["Logs.Retention.Calls"]" type="number" min="1" max="3650" step="1" hint="@L["Logs.Retention.Rows", Model.Counts.Calls]" />
            <mp-input for="Input.TelephonyDays" label="@L["Logs.Retention.Telephony"]" type="number" min="1" max="3650" step="1" hint="@L["Logs.Retention.Rows", Model.Counts.Telephony]" />
            <mp-input for="Input.ActivityDays" label="@L["Logs.Retention.Activity"]" type="number" min="1" max="3650" step="1" hint="@L["Logs.Retention.Rows", Model.Counts.Activity]" />
            <mp-input for="Input.HeardMessageDays" label="@L["Logs.Retention.Messages"]" type="number" min="0" max="3650" step="1" hint="@L["Logs.Retention.Messages.Hint"]" />
        </div>
    </mp-card>
    <mp-buttons back-href="/Admin/Logs/Calls" back-text="@L["Shell.Nav.CallLog"]" />
</form>

<mp-card title="@L["Logs.Retention.Now"]" icon="broom">
    <p class="mat-muted">@L["Logs.Retention.Now.Hint"]</p>
    <form method="post" class="mat-actions">
        <button type="submit" asp-page-handler="Clean" class="mat-btn mat-btn--secondary" data-confirm="@L["Logs.Retention.Now.Confirm"]" data-confirm-ok="@L["Logs.Retention.Now.Ok"]">@Ui.Icon("broom")<span>@L["Logs.Retention.Now.Run"]</span></button>
    </form>
</mp-card>
