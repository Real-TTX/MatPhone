@page
@model MatPhone.Pages.Admin.Lines.IndexModel

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />
    <partial name="_Table" model="Model.Table" />
    <partial name="_Pager" model="Model.Pager" />
    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="/Admin/Lines/Edit">@Ui.Icon("plus")<span>@L["Lines.New"]</span></a>
        <a class="mat-btn mat-btn--secondary" href="/Admin/Profiles">@Ui.Icon("template")<span>@L["Shell.Nav.Profiles"]</span></a>
    </div>
</div>
