{
  "name": "MatPhone",
  "short_name": "MatPhone",
  "description": "The telephone system in the browser: phone, call list, mailbox and the administration of the installation.",
  "id": "/",
  "start_url": "/Phone?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "lang": "de",
  "dir": "ltr",
  "background_color": "#f5f4f1",
  "theme_color": "#f5f4f1",
  "categories": ["business", "communication", "productivity"],
  "icons": [
    { "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/img/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Telefon", "url": "/Phone", "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Anrufe", "url": "/Calls", "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mailbox", "url": "/Voicemail", "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }] }
  ]
}
